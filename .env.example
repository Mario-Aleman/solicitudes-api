# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# --- Modo de la API: "simple" (version base) o "mejorado" (colas + lotes + reintentos)
MODO=simple

# --- Microsoft 365 (Microsoft Entra ID -> Registro de aplicaciones)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Excel en OneDrive
EXCEL_USER=            # correo (UPN) del dueno del OneDrive, ej: docente@institucion.edu.co
EXCEL_FILE_PATH=Solicitudes.xlsx
EXCEL_TABLE=Solicitudes

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pruebas locales sin credenciales (simula Excel y Telegram)
SIMULAR=false
